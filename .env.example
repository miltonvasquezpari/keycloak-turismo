# ===== PostgreSQL =====
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=keycloak
POSTGRES_DB=keycloak

# Base de datos de la aplicación (creada por postgres/init/01-app.sh)
APP_DB_NAME=turismo_app
APP_DB_USER=turismo
APP_DB_PASSWORD=turismo

# ===== Keycloak =====
# Bootstrap admin (admin inicial del master realm)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# Conexión Keycloak -> Postgres
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=keycloak

# ===== Secretos de clientes Keycloak =====
# Se referencian como placeholders ${...} en los JSON de realms
TURISMO_API_SECRET=cambiar-en-local
PARTNERS_INTEGRACION_SECRET=cambiar-en-local

# ===== Identity Provider: GitHub (Fase 7) =====
GITHUB_CLIENT_ID=cambiar-en-local
GITHUB_CLIENT_SECRET=cambiar-en-local

# ===== Zona horaria =====
TZ=America/Lima
