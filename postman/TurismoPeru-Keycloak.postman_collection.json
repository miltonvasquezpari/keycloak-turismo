      "name": "00 Discovery",
      "item": [
        {
          "name": "well-known realm turismo",
          "event": [{"listen":"test","script":{"exec":["pm.test('status 200', ()=> pm.response.to.have.status(200));","pm.test('issuer correcto', ()=> pm.expect(pm.response.json().issuer).to.eql(pm.environment.get('kc_url')+'/realms/'+pm.environment.get('realm_turismo')));"],"type":"text/javascript"}}],
          "request": {"method":"GET","url":"{{kc_url}}/realms/{{realm_turismo}}/.well-known/openid-configuration"}
        },
        {
          "name": "well-known realm agencias-partners",
          "event": [{"listen":"test","script":{"exec":["pm.test('status 200', ()=> pm.response.to.have.status(200));"],"type":"text/javascript"}}],
          "request": {"method":"GET","url":"{{kc_url}}/realms/{{realm_partners}}/.well-known/openid-configuration"}
        }
      ]
    },
